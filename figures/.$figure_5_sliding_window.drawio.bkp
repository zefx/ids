        <mxCell id="NOTE" parent="1" style="text;html=1;align=left;verticalAlign=top;fontFamily=Times New Roman;fontSize=12;fontStyle=0;labelBackgroundColor=none;" value="&lt;span&gt;Each source IP has its own independent window. Window state and feature computation are O(k) per flow via running sums and a port counter.&lt;/span&gt;" vertex="1">
